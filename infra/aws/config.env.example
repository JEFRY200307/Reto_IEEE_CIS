# Copiar a config.env (no se sube a git), o generarlo desde dsqa-infra:
#   terraform -chdir=envs/dev output -raw config_env > ../Reto_IEEE_CIS/infra/aws/config.env
AWS_PROFILE=dsqa
AWS_ACCOUNT_ID=<id-de-tu-cuenta-12-digitos>
AWS_REGION=us-east-1
DSQA_BUCKET=dsqa-data-<id-de-tu-cuenta>
LAUNCH_TEMPLATE=dsqa-p5
LAUNCH_TEMPLATE_FALLBACK=dsqa-g6e
LAUNCH_TEMPLATE_PREP=dsqa-prep
INSTANCE_PROFILE=dsqa-ec2
MAX_HOURS_DEFAULT=3
